[Desktop Entry]
Name=Jack Graph
Comment=JACK and ALSA port connection manager
Exec=jack-graph
Icon=audio-card
Terminal=false
Type=Application
Categories=AudioVideo;Audio;Midi;Multimedia;
Keywords=audio;JACK;ALSA;MIDI;connections;
# Ties the window to this entry in a dock or task list: it must match the res_class in the
# window's WM_CLASS, which src/main.cpp sets with X11Window::open(..., "jack-graph", ...). The
# JACK Settings and About dialogs carry the same class, so a dock groups them with the graph
# instead of listing three applications.
StartupWMClass=jack-graph
